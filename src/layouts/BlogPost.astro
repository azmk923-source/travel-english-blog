---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<style>
			.article-hero {
				width: 100%;
				max-height: 440px;
				overflow: hidden;
			}
			.article-hero img {
				width: 100%;
				height: 440px;
				object-fit: cover;
				border-radius: 0;
			}
			.article-wrap {
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			.pr-notice {
				font-size: 0.75rem;
				color: var(--text-muted);
				text-align: right;
				padding: 0.6rem 0;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2rem;
			}
			.article-header {
				padding: 2.5rem 0 1.5rem;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2.5rem;
			}
			.article-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1.2rem;
			}
			.article-tag {
				display: inline-block;
				background: var(--accent-light);
				color: var(--accent);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding: 0.2rem 0.7rem;
				border-radius: 20px;
			}
			.article-date {
				font-size: 0.78rem;
				color: var(--text-muted);
			}
			.article-updated {
				font-size: 0.75rem;
				color: var(--text-muted);
				font-style: italic;
				margin-top: 0.3rem;
			}
			.article-header h1 {
				font-size: clamp(1.5rem, 4vw, 2rem);
				font-weight: 900;
				line-height: 1.35;
				margin: 0;
				letter-spacing: -0.02em;
			}
			.prose {
				color: var(--text);
				padding-bottom: 4rem;
			}
			.prose :global(h2) {
				font-size: 1.4rem;
				margin: 2.5rem 0 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid var(--accent-light);
			}
			.prose :global(h3) {
				font-size: 1.1rem;
				margin: 2rem 0 0.8rem;
			}
			.prose :global(p) { margin-bottom: 1.6em; }
			.prose :global(ul), .prose :global(ol) {
				padding-left: 1.4em;
				margin-bottom: 1.6em;
			}
			.prose :global(li) { margin-bottom: 0.4em; }
			.prose :global(a) { color: var(--accent); font-weight: 600; }
			.prose :global(strong) { color: var(--text); }

			@media (max-width: 720px) {
				.article-wrap { padding: 0 1rem; }
				.article-header { padding: 1.5rem 0 1.2rem; }
				.article-hero img { height: 240px; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			{heroImage && (
				<div class="article-hero">
					<img src={heroImage} alt={title} />
				</div>
			)}
			<div class="article-wrap">
				<p class="pr-notice">※本記事にはプロモーション（広告）が含まれます。</p>
				<header class="article-header">
					<div class="article-meta">
						<span class="article-tag">旅行英語</span>
						<span class="article-date"><FormattedDate date={pubDate} /></span>
					</div>
					<h1>{title}</h1>
					{updatedDate && (
						<p class="article-updated">最終更新: <FormattedDate date={updatedDate} /></p>
					)}
				</header>
				<div class="prose">
					<slot />
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
