---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.page-title {
				font-size: 1.3rem;
				margin: 0 0 1.5rem;
				color: rgb(var(--black));
				border-left: 4px solid #764ba2;
				padding-left: 0.8rem;
			}
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				transition: box-shadow 0.2s, transform 0.2s;
			}
			.post-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.post-card a {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.2rem 1.5rem;
				text-decoration: none;
				color: inherit;
				gap: 1rem;
			}
			.post-info {
				flex: 1;
			}
			.post-card h2 {
				margin: 0 0 0.4rem;
				font-size: 1.05rem;
				color: rgb(var(--black));
				line-height: 1.5;
			}
			.post-card .desc {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin: 0 0 0.5rem;
				line-height: 1.6;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card .date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.post-arrow {
				font-size: 1.2rem;
				color: #764ba2;
				flex-shrink: 0;
			}
			.post-card:hover .post-arrow {
				transform: translateX(4px);
				transition: transform 0.2s;
			}
			@media (max-width: 600px) {
				.post-card a {
					padding: 1rem;
				}
				.post-card h2 {
					font-size: 0.95rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">📝 記事一覧（{posts.length}件）</h1>
			<ul class="posts-list">
				{
					posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`}>
								<div class="post-info">
									<h2>{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
								<span class="post-arrow">→</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
