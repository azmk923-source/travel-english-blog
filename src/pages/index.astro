---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ヒーロー */
			.hero {
				background: #0f0f0f;
				color: #fff;
				padding: 5rem 1.5rem;
			}
			.hero-inner {
				max-width: 760px;
				margin: 0 auto;
			}
			.hero-label {
				display: inline-block;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #a78bfa;
				border: 1px solid #a78bfa;
				padding: 0.25rem 0.8rem;
				border-radius: 20px;
				margin-bottom: 1.5rem;
			}
			.hero h1 {
				font-size: 2.4rem;
				font-weight: 900;
				line-height: 1.3;
				margin: 0 0 1.2rem;
				color: #fff;
			}
			.hero h1 span {
				color: #a78bfa;
			}
			.hero p {
				font-size: 1rem;
				color: #9ca3af;
				margin: 0 0 2rem;
				line-height: 1.8;
			}
			.hero-btn {
				display: inline-block;
				background: #6d28d9;
				color: #fff;
				font-weight: 700;
				font-size: 0.9rem;
				padding: 0.8rem 2rem;
				border-radius: 8px;
				text-decoration: none;
				letter-spacing: 0.03em;
				transition: background 0.2s, transform 0.2s;
			}
			.hero-btn:hover {
				background: #5b21b6;
				transform: translateY(-2px);
			}

			/* コンセプト */
			.concept {
				background: #f9fafb;
				padding: 4rem 1.5rem;
				border-bottom: 1px solid #e5e7eb;
			}
			.concept-inner {
				max-width: 900px;
				margin: 0 auto;
			}
			.section-header {
				margin-bottom: 2.5rem;
			}
			.section-header .en {
				display: block;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #6d28d9;
				margin-bottom: 0.3rem;
			}
			.section-header h2 {
				font-size: 1.5rem;
				font-weight: 800;
				color: #111827;
				margin: 0;
			}
			.concept-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.2rem;
			}
			.concept-item {
				background: #fff;
				border: 1px solid #e5e7eb;
				border-radius: 12px;
				padding: 1.5rem;
			}
			.concept-icon {
				font-size: 1.8rem;
				margin-bottom: 0.6rem;
			}
			.concept-item h3 {
				font-size: 0.9rem;
				font-weight: 700;
				margin: 0 0 0.4rem;
				color: #111827;
			}
			.concept-item p {
				font-size: 0.8rem;
				color: #6b7280;
				margin: 0;
				line-height: 1.7;
			}

			/* 記事セクション */
			.articles {
				max-width: 1000px;
				margin: 0 auto;
				padding: 4rem 1.5rem;
			}
			.section-actions {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				margin-bottom: 2rem;
			}
			.view-all {
				font-size: 0.8rem;
				font-weight: 700;
				color: #6d28d9;
				text-decoration: none;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}
			.view-all:hover { text-decoration: underline; }

			/* グリッド */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.2rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-card {
				background: #fff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				overflow: hidden;
				transition: box-shadow 0.25s, transform 0.25s;
			}
			.post-card:hover {
				box-shadow: 0 8px 32px rgba(109,40,217,0.1);
				transform: translateY(-3px);
			}
			.post-card a {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}
			.card-thumb {
				width: 100%;
				height: 160px;
				object-fit: cover;
				display: block;
			}
			.card-thumb-placeholder {
				width: 100%;
				height: 160px;
				background: linear-gradient(135deg, #ede9fe, #ddd6fe);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 2.5rem;
			}
			.card-body {
				padding: 1.4rem 1.5rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.card-tag {
				display: inline-block;
				background: #ede9fe;
				color: #6d28d9;
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				padding: 0.2rem 0.7rem;
				border-radius: 20px;
				margin-bottom: 0.8rem;
				width: fit-content;
			}
			.card-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: #111827;
				line-height: 1.5;
				margin: 0 0 0.6rem;
			}
			.card-desc {
				font-size: 0.8rem;
				color: #6b7280;
				line-height: 1.7;
				margin: 0 0 1rem;
				flex: 1;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1px solid #e5e7eb;
				padding-top: 0.8rem;
			}
			.card-date {
				font-size: 0.72rem;
				color: #9ca3af;
			}
			.card-arrow {
				font-size: 0.8rem;
				color: #6d28d9;
				font-weight: 700;
				transition: transform 0.2s;
			}
			.post-card:hover .card-arrow { transform: translateX(4px); }

			@media (max-width: 640px) {
				.hero h1 { font-size: 1.7rem; }
				.concept-grid { grid-template-columns: 1fr; }
				.posts-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="hero-inner">
					<span class="hero-label">Travel English Blog</span>
					<h1>アジア旅行を<span>もっと楽しむ</span><br />英語学習ブログ</h1>
					<p>
						台湾・タイ・ベトナム・香港への旅行経験をもとに<br />
						「旅行で本当に使える英語」を発信しています
					</p>
					<a href="/blog" class="hero-btn">記事を読む →</a>
				</div>
			</section>

			<!-- Concept -->
			<section class="concept">
				<div class="concept-inner">
					<div class="section-header">
						<span class="en">About</span>
						<h2>このブログについて</h2>
					</div>
					<div class="concept-grid">
						<div class="concept-item">
							<div class="concept-icon">🌏</div>
							<h3>実体験ベース</h3>
							<p>台湾・タイ・ベトナム・香港への旅行経験から本音を発信</p>
						</div>
						<div class="concept-item">
							<div class="concept-icon">📱</div>
							<h3>アプリ活用法</h3>
							<p>毎日Duolingoを続けているからこそわかる継続のコツ</p>
						</div>
						<div class="concept-item">
							<div class="concept-icon">💬</div>
							<h3>使える英語</h3>
							<p>ホテル・夜市・観光地で実際に使ったフレーズを紹介</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Articles -->
			<section class="articles">
				<div class="section-actions">
					<div class="section-header" style="margin-bottom:0">
						<span class="en">Latest Articles</span>
						<h2>最新記事</h2>
					</div>
					<a href="/blog" class="view-all">View All →</a>
				</div>
				<ul class="posts-grid">
					{posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage
									? <img class="card-thumb" src={post.data.heroImage} alt={post.data.title} />
									: <div class="card-thumb-placeholder">✈️</div>
								}
								<div class="card-body">
									<span class="card-tag">旅行英語</span>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
									<div class="card-footer">
										<span class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="card-arrow">Read →</span>
									</div>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
